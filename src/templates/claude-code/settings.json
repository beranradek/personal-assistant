{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-context --hook-json"
          },
          {
            "type": "command",
            "command": "pa claude-remote-hook listen-start",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-security-hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-remote-hook PreToolUse",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-remote-hook listen-stop",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-remote-hook StopFailure",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-remote-hook UserPromptSubmit",
            "async": true
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-remote-hook MessageDisplay",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-remote-hook Notification",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pa claude-remote-hook SessionEnd",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__pa__memory_search",
      "mcp__pa__memory_lint",
      "mcp__pa__episode_recent",
      "mcp__pa__episode_search",
      "mcp__pa__episode_stats",
      "mcp__pa__cron_list",
      "mcp__pa__habit_status",
      "mcp__pa__process",
      "mcp__pa__exec",
      "mcp__pa__habit_check",
      "mcp__pa__episode_write",
      "mcp__pa__cron_create",
      "mcp__pa__cron_update",
      "mcp__pa__cron_remove",
      "mcp__pa__integ_list",
      "mcp__pa__integ_gmail",
      "mcp__pa__integ_calendar",
      "mcp__pa__integ_slack",
      "mcp__pa__agent_session_list",
      "mcp__pa__agent_session_status",
      "mcp__pa__agent_session_read",
      "mcp__pa__agent_session_attach",
      "mcp__pa__agent_session_start",
      "mcp__pa__agent_session_send",
      "mcp__pa__agent_session_interrupt",
      "mcp__pa__remote_session_status",
      "mcp__pa__remote_session_attach",
      "mcp__pa__remote_session_detach",
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ]
  }
}
