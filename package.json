{
  "name": "personal-assistant",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "pa": "./dist/cli.js"
  },
  "scripts": {
    "terminal": "tsx src/terminal.ts",
    "daemon": "tsx src/daemon.ts",
    "build": "tsc && rm -rf dist/templates && cp -r src/templates dist/templates",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "episode-eval": "node dist/cli.js episode-eval",
    "episode-eval:json": "node dist/cli.js episode-eval --json",
    "episode-eval:artifact": "node dist/cli.js episode-eval --output ./tmp/episode-eval-report.json",
    "episode-eval:summary": "node scripts/render-episode-eval-summary.mjs",
    "episode-eval:gate": "node scripts/run-episode-eval-gate.mjs",
    "postinstall": "node scripts/prune-gpu-prebuilds.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.147.0",
    "@slack/bolt": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.8.1",
    "grammy": "^1.45.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "node-cron": "^4.6.0",
    "node-llama-cpp": "^3.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
